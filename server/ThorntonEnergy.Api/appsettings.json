{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "TimeZone": "America/New_York"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Issuer": "ThorntonEnergy.Api",
    "Audience": "ThorntonEnergy.Client",
    "ExpiresMinutes": 60
  },
  "Services": {
    "Billing": "http://localhost:5097",
    "Outages": "http://localhost:5098",
    "Customers": "http://localhost:5099"
  }
}
