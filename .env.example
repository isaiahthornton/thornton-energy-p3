# Copy this file to .env and fill in real values.
# .env is ignored by git. Never commit it or paste its values in chat.

# Password for the SQL Server "sa" account (db container and API connection string)
# Needs 8+ characters with upper case, lower case, a number and a symbol.
SQL_PASSWORD=

# Secret used to sign login tokens (JWT). Long random string, 32+ characters.
JWT_KEY=

# Chat assistant: a model deployed in Azure AI Foundry (a plain model deployment, not an Agent).
# FOUNDRY_ENDPOINT is the full chat-completions address, e.g. https://<resource>.services.ai.azure.com/openai/v1/chat/completions
# FOUNDRY_AGENT_ID is the deployment name you chose. FOUNDRY_API_KEY is the key from the portal.
# Leave these out of git and out of chat messages.
FOUNDRY_ENDPOINT=
FOUNDRY_AGENT_ID=
FOUNDRY_API_KEY=

# Optional settings (defaults shown). Uncomment a line to change it.
# ASPNETCORE_ENVIRONMENT=Production   # set to Development to turn on Swagger (demo only)
# DB_PORT=14330
# API_PORT=8080
# WEB_PORT=4200